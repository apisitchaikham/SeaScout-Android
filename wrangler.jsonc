// Cloudflare Workers Builds: the Sea Scout website.
// Build command:  bash tools/build_site.sh     Deploy command: npx wrangler deploy
// Static files in ./site are served directly; worker/site.js handles /api/crash (anonymous error reports)
// and /api/v1/* (central membership API, worker/api/) backed by the D1 database below (r14.15.59).
{
  "name": "seascout",
  "compatibility_date": "2026-11-01",
  "main": "worker/site.js",
  "assets": { "directory": "./site", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Facebook Login (App ID 986357267420012) is switched off until Meta business verification: add "FACEBOOK_APP_ID" back here to turn it on.
  // Public ids only (safe in git). Secrets (GOOGLE_WEB_CLIENT_SECRET, FACEBOOK_APP_SECRET, …) live in the Cloudflare dashboard.
  "vars": {
    "GOOGLE_WEB_CLIENT_ID": "491667475897-vqc2k8knoj6i2uo86fhe97vhf0le9lsl.apps.googleusercontent.com",
    "GOOGLE_CLIENT_IDS": "491667475897-vqc2k8knoj6i2uo86fhe97vhf0le9lsl.apps.googleusercontent.com"
  },
  "keep_vars": true,
  "d1_databases": [
    { "binding": "DB", "database_name": "seascout-db", "database_id": "750cb03b-b883-481c-941a-2acfd322fe73", "migrations_dir": "migrations" }
  ]
}
